# --- Geheimnisse & Zugangsdaten ---
# .storage enthaelt Klartext-Passwoerter/Tokens fuer alle Integrationen
# (core.config_entries), Login-Sessions (auth) und HomeKit-Pairing-Keys.
# NIEMALS committen, auch nicht in ein privates Repo.
.storage/
secrets.yaml
*.token
*.key
*.pem

# --- Datenbanken & Laufzeit-State ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
.ha_run.lock
home-assistant.log
home-assistant.log.*
*.log
.ha_mcp/

# --- Caches, generierte & herunterladbare Inhalte ---
.cache/
.cloud/
deps/
tts/
image/
www/community/
www/ha_washdata/preview/
custom_components/**/__pycache__/
custom_components/**/*.pyc
**/__pycache__/
*.pyc

# --- Backups & Uploads ---
*.tar
*.tar.gz
backups/

# --- Editor / OS / Tooling ---
.vscode/
.claude/
.DS_Store

# --- ESPHome ---
# Geraete-YAMLs enthalten API-Schluessel und OTA-Passwoerter im Klartext;
# der Device Builder versioniert den Ordner selbst (esphome/.git auf dem Pi).
esphome/

# --- Fremd-Integrationen (HACS / Add-on-verwaltet) ---
# Reproduzierbar ueber HACS, enthalten teils oeffentliche API-Keys der Anbieter
# (GitHub Push Protection blockt diese). Nur eigene Komponenten versionieren.
custom_components/*
!custom_components/paket_tracking/

# --- Dashboard-Tests ---
tests/dashboard/node_modules/
tests/dashboard/.screenshots/
